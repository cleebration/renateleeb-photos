{
  "name": "renateleeb-photos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Fotografie-Portfolio von Renate Leeb — statisch, Galerie aus dem cleebration-Galerie-Kit.",
  "scripts": {
    "feeds": "cd hub && node scripts/build-feeds.mjs",
    "images": "cd hub && node scripts/build-images.mjs",
    "build": "npm run feeds && node scripts/build.mjs",
    "dev": "npm run build && npx serve dist",
    "deploy": "npm run build && npx wrangler deploy",
    "preview": "npm run build && node scripts/build-preview.mjs",
    "test": "node test/smoke.mjs && node test/galerie.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/karla": "^5.3.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^30.1.1",
    "marked": "^12.0.2",
    "sharp": "^0.33.5"
  }
}
