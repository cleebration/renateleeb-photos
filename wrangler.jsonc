{
  "name": "renateleeb-photos",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Der Worker entscheidet zuerst — sonst beantwortet die Asset-Schicht
    // Adressen, für die es eine Weiterleitung gibt.
    "run_worker_first": true
  },
  "observability": { "enabled": true },
  "vars": {
    "KONTAKT_EMPFAENGER": "kontakt@renateleeb.photos"
  },
  // Die eigene Domain. „custom_domain" heißt: Cloudflare pflegt den
  // DNS-Eintrag selbst — deshalb darf daneben KEIN A- oder CNAME-Eintrag
  // für denselben Namen stehen. Die alten Wix-Einträge sind am 27.09.
  // gelöscht worden, vorher wäre ein Deploy hier gescheitert.
  // www zeigt ebenfalls hierher; die Umleitung auf die Adresse ohne www
  // macht der Worker selbst (worker/index.js).
  "routes": [
    { "pattern": "renateleeb.photos", "custom_domain": true },
    { "pattern": "www.renateleeb.photos", "custom_domain": true }
  ]
  // Geheimnisse NICHT hier eintragen, sondern:
  //   npx wrangler secret put FORM_WEBHOOK_URL     (Zapier Catch Hook)
  //   npx wrangler secret put RESEND_API_KEY       (Alternative: Resend)
}
