{
  "name": "gallery-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Zentrale Medien-Quelle (Fotos/Videos) für mehrere Websites. Baut JSON-Feeds pro Site und pro Galerie. Editor: Sveltia CMS.",
  "scripts": {
    "build": "node scripts/build-feeds.mjs",
    "images": "node scripts/build-images.mjs",
    "cms": "npx @sveltia/cms-proxy-server",
    "serve": "npx serve public"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^12.0.2"
  },
  "devDependencies": {
    "sharp": "^0.33.5"
  }
}
